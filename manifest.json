{
  "manifest_version": 3,
  "name": "Infinite Scroll Extension",
  "version": "1.0",
  "description": "ページを無限にスクロールし続ける拡張機能",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
